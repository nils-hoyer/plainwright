{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "examples"]
}
