{
  "name": "plainwright-starter",
  "private": true,
  "description": "Starter project for readable, keyword-driven Playwright tests.",
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "plainwright test",
    "report": "playwright show-report",
    "app": "node app/server.mjs",
    "lint": "plainwright lint --features 'features/**/*.feature' --quiet",
    "inspect": "plainwright inspect"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright-bdd": "^9.2.1",
    "@nils.hoyer/plainwright": "^0.2.0"
  }
}
