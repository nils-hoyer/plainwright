{
  "name": "@nils.hoyer/plainwright",
  "version": "0.1.0",
  "description": "Readable, keyword-driven tests built on Playwright and playwright-bdd.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "plainwright": "dist/cli.js"
  },
  "files": [
    "dist/",
    "templates/",
    "!dist/**/*.map",
    "schema/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write '**/*.{ts,json,md}'",
    "format:check": "prettier --check '**/*.{ts,json,md}'",
    "typecheck": "tsc --noEmit",
    "docs": "jiti scripts/docs.ts",
    "docs:check": "jiti scripts/docs.ts --check",
    "lint:features": "jiti src/cli.ts lint --features 'test/features/**/*.feature' --steps 'test/steps/**/*.ts' --quiet",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "bddgen && playwright test",
    "verify": "npm run format:check && npm run typecheck && npm run docs:check && npm run lint:features && npm test",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nils-hoyer/plainwright.git"
  },
  "keywords": [
    "playwright",
    "keyword-driven",
    "bdd",
    "gherkin",
    "cucumber",
    "robot-framework",
    "gauge"
  ],
  "author": "Nils Hoyer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nils-hoyer/plainwright/issues"
  },
  "homepage": "https://github.com/nils-hoyer/plainwright#readme",
  "peerDependencies": {
    "@playwright/test": ">=1.53.0",
    "playwright-bdd": "^9.0.0"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "19.0.0",
    "@cucumber/gherkin": "^39.1.0",
    "@cucumber/messages": "^32.3.1",
    "jiti": "^2.7.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
