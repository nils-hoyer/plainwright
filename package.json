{
  "name": "playwright-bdd-steps",
  "version": "1.0.0",
  "description": "Pre-built BDD step definitions for Playwright covering all common browser interactions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./steps/*": {
      "types": "./dist/steps/*.d.ts",
      "default": "./dist/steps/*.js"
    },
    "./fixtures/*": {
      "types": "./dist/fixtures/*.d.ts",
      "default": "./dist/fixtures/*.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*.d.ts",
      "default": "./dist/pages/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit -p test/tsconfig.json",
    "test:e2e": "vitest run test/e2e.test.ts --test-timeout 120000",
    "test": "npm run lint && npm run test:e2e",
    "format": "prettier --write '**/*.{ts,json,md}'",
    "format:check": "prettier --check '**/*.{ts,json,md}'",
    "verify": "npm run format:check && npm run lint && npm run test:e2e",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nils-hoyer/playwright-bdd-steps.git"
  },
  "keywords": [
    "playwright",
    "bdd",
    "gherkin",
    "cucumber",
    "test",
    "e2e",
    "page-object",
    "steps"
  ],
  "author": "Nils Hoyer",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nils-hoyer/playwright-bdd-steps/issues"
  },
  "homepage": "https://github.com/nils-hoyer/playwright-bdd-steps#readme",
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "playwright-bdd": ">=7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "playwright-bdd": "^8.5.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
